  "authors": [
    "Zennin"
  ],
  "license": "AFL-3.0",
  "icon": "assets/mushoku_combat/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.zennin.mushokucombat.MushokuCombat"
    ],
    "client": [
      "net.zennin.mushokucombat.client.CombatClient"
    ]
  },
  "mixins": [
    "mushoku_combat.mixins.json",
    "mushoku_combat.skinlayers.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "remushoku": "*",
    "bettercombat": ">=2.0.0",
    "playeranimator": ">=2.0.0"
